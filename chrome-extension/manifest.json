{
  "manifest_version": 3,
  "name": "TNT Scrapping Creator",
  "version": "2.0.0",
  "description": "Auto-Scrape Kreator TikTok Partner Center dengan Buku Catatan Anti-Duplikat & Staging Creator TNT",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://partner.tiktokshop.com/*",
    "https://affiliate.tiktok.com/*",
    "http://localhost:*/*",
    "https://campaign.tntkreatif.com/*",
    "*://*.kalodata.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://partner.tiktokshop.com/*",
        "*://affiliate.tiktok.com/*",
        "*://campaign.tntkreatif.com/*",
        "http://localhost:*/*",
        "*://*.kalodata.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TNT Scrapping Creator",
    "default_popup": "popup.html"
  }
}
