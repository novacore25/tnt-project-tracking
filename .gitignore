# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Large data files
*.csv
*.xlsx
*.xls

# SQL hasil impor payment historis - MENGANDUNG DATA PII.
# NIK, nomor rekening, dan nama penerima ada di dalam file ini. Nama file
# di sini WAJIB eksplisit supaya tidak salah commit. Prinsipnya: data yang
# masuk DB produksi tidak harus masuk git history.
# Lihat docs/payment/PII.md.
docs/sql/7*-insert-payment-historis.sql
docs/payment/payment-historis-lokal.sql

# Cache hasil parse Excel payment / laporan TikTok.
# SEMUA file .txt di docs/payment/ adalah turunan mentah dari Excel yang
# di-upload owner. Sebagian berisi NIK 16 digit, nomor rekening, dan nama
# penerima. File ini sempat ter-commit sebelum aturan ini dibuat - sudah
# di-`git rm --cached`, tapi ISI LAMA MASIH ADA di git history.
# Lihat docs/payment/PII.md bagian "riwayat git".
docs/payment/*.txt

# OS generated files
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Agent tooling
.agents/

# Utilitas one-off (audit, diagnose, one-time-data-fix).
# Bukan bagian dari build. Sebagian berisi kredensial DB hardcoded
# dan TIKTOK_APP_SECRET, jadi tidak boleh masuk repo publik.
# File yang sudah terlanjur ter-track tidak dihapus dari riwayat oleh
# .gitignore; see docs/audit/2026-09-30-AUDIT.md section 6.1.
web-app/scripts/